{
  "framework": null,
  "buildCommand": "npm run web:build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index?__teckup_path="
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__teckup_path=:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
